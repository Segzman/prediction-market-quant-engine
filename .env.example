# Required
POLYMARKET_PRIVATE_KEY=0xyour_key_here

# Optional: if omitted, the client will derive API creds from POLYMARKET_PRIVATE_KEY
POLYMARKET_API_KEY=
POLYMARKET_SECRET=
POLYMARKET_PASSPHRASE=

# Wallet settings for live trading
POLYMARKET_SIGNATURE_TYPE=0
POLYMARKET_FUNDER=

# Set to False only after validating strategy in dry run
DRY_RUN=True

# Optional
LOG_LEVEL=INFO
LEDGER_FILE=trades.jsonl
BOT_LOCK_FILE=.bot.lock
ALERTS_FILE=alerts.jsonl
ALERT_WEBHOOK_URL=
RUNTIME_STATUS_FILE=runtime_status.json
RUNTIME_STATUS_UPDATE_SECONDS=2
LIVE_RECON_LOOKBACK_SECONDS=86400
USE_KELLY=False
TARGET_ASSET=BTC
SHADOW_MULTI_TRACK_EXECUTION=True
ENTRY_MIN_CONTRACT_PRICE=0.55
ENTRY_MAX_CONTRACT_PRICE=0.62
# Start watching earlier, but only enter before the main snipe when both
# liquidity and expected net profit are materially stronger than the floor.
EARLY_ENTRY_START_SECONDS=35
SNIPE_MIN_CONFIDENCE=0.52
LIQUIDITY_MIN_ASK_COUNT=10
LIQUIDITY_MIN_BID_COUNT=10
LIQUIDITY_MAX_SIDE_SPREAD=0.08
LIQUIDITY_MIN_SCORE=0.45
EARLY_ENTRY_MIN_SCORE=0.70
MIN_EXPECTED_PROFIT_USDC=0.03
EARLY_ENTRY_MIN_EXPECTED_PROFIT_USDC=0.06
EXPECTED_SLIPPAGE_BPS=25
MIN_BET_USDC=2
# Leave forced trades on only for pressure-testing. The new runtime is now able
# to stay flat on weak books and low-net-profit windows.
FORCE_INTERVAL_TRADES=False
HEDGE_ENABLED=True
LIVE_ORDER_TYPE=GTC
