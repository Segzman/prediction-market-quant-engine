[Unit]
Description=PMQE paper trading bot (shadow-live, dry-run orders)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
Type=simple
User=__PMQE_USER__
Group=__PMQE_GROUP__
WorkingDirectory=__PMQE_HOME__
EnvironmentFile=__PMQE_STATE_DIR__/.env
Environment=PYTHONUNBUFFERED=1
Environment=PMQE_HOME=__PMQE_HOME__
Environment=PMQE_STATE_DIR=__PMQE_STATE_DIR__
ExecStartPre=/bin/bash __PMQE_HOME__/deploy/vm/guard.sh
ExecStart=/bin/bash __PMQE_HOME__/deploy/vm/run-bot.sh
Restart=always
RestartSec=10
RestartPreventExitStatus=78
KillMode=process
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
