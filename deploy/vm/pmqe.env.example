# Paper-mode environment for the PMQE VM deployment.
# bootstrap.sh copies this file to the state directory as .env on first run.
# Secrets are added by the operator in that copy and are never committed.

DRY_RUN=True
ALLOW_LIVE=0

LOG_LEVEL=INFO
ACTIVE_MODEL_TRACK=BOTH
PMQE_MODELS=A,B,C
TARGET_ASSET=BTC

DATA_DIR=__PMQE_STATE_DIR__/data
LEDGER_FILE=__PMQE_STATE_DIR__/ledgers/both.jsonl
LEDGER_FILE_CONVICTION=__PMQE_STATE_DIR__/ledgers/conviction.jsonl
LEDGER_FILE_MISPRICING=__PMQE_STATE_DIR__/ledgers/mispricing.jsonl
LEDGER_FILE_BOTH=__PMQE_STATE_DIR__/ledgers/both.jsonl
MODEL_C_CALIBRATION_FILE=__PMQE_STATE_DIR__/model_c_calibration.json
BOT_LOCK_FILE=__PMQE_STATE_DIR__/.bot.lock
ALERTS_FILE=__PMQE_STATE_DIR__/alerts.jsonl
RUNTIME_STATUS_FILE=__PMQE_STATE_DIR__/runtime_status.json
RUNTIME_STATUS_UPDATE_SECONDS=2

# Optional AI judgment experiment. Leave the key empty to keep it disabled.
JEV_NOUL_ENABLED=False
JEV_CALLS_FILE=__PMQE_STATE_DIR__/jev_calls.jsonl
TYPESAFE_API_KEY=

# Dashboard. Controls stay hidden and POST requests are rejected while
# PMQE_WEB_ALLOW_CONTROLS is not 1.
PORT=8765
PMQE_WEB_HOST=0.0.0.0
PMQE_WEB_ALLOW_CONTROLS=0

# Outbound proxy. Uncomment and edit when the VM needs one.
# HTTPS_PROXY=http://proxy.example:3128
# HTTP_PROXY=http://proxy.example:3128
# NO_PROXY=localhost,127.0.0.1,::1
